@model dockerProject.Models.Account

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DockVerse — @ViewData["Title"]</title>

    <!-- Bootstrap CSS (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="" crossorigin="anonymous">

    <style>
        /* Background and centering */
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 10% 10%, #0d6efd08, transparent 10%), linear-gradient(135deg, #f6f9ff 0%, #eef4ff 100%);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            margin: 0;
        }

        /* Card */
        .login-card {
            width: 100%;
            max-width: 420px;
            border: none;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 8px 30px rgba(14, 30, 60, 0.08);
            background: #ffffff;
        }

        .brand {
            text-align: center;
            margin-bottom: 0.75rem;
        }

            .brand h1 {
                margin: 0;
                font-size: 1.6rem;
                font-weight: 700;
                letter-spacing: 0.2px;
            }

            .brand .subtitle {
                color: #6c757d;
                font-size: 0.9rem;
                margin-top: 0.25rem;
            }

        .login-form .form-control {
            border-radius: 8px;
            padding: 0.75rem 0.9rem;
        }

        .btn-login {
            width: 100%;
            padding: 0.72rem;
            border-radius: 8px;
        }

        .muted-note {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .login-footer {
            margin-top: 0.9rem;
            text-align: center;
            font-size: 0.85rem;
            color: #95a1b6;
        }

        /* Validation summary spacing */
        .validation-summary-valid,
        .validation-summary-errors {
            margin-top: 0.5rem;
        }
    </style>
</head>
<body>

    <main class="container">
        <div class="d-flex align-items-center justify-content-center min-vh-100">
            <div class="login-card">
                <div class="brand">
                    <h1>DockVerse</h1>
                    <div class="subtitle">Training Server if it was good.</div>
                </div>

                <hr /> 

                <form class="login-form" asp-action="Login" asp-controller="Account" method="post" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input autofocus type="text" class="form-control" id="username" asp-for="Username" />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" asp-for="Password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div>
                        <button type="submit" class="btn btn-primary btn-login">Login</button>
                    </div>

                    <div class="mt-3"> <!-- Shows if you inserted wrong values-->
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>