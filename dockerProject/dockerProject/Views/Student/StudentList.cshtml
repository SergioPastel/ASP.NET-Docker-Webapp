@model IEnumerable<dockerProject.Models.Student>

@{
    ViewData["Title"] = "StudentList";
}

<h1>StudentList</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Password)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateOfBirth)
            </td>
            <td>
                    <form class="d-inline" asp-action="StudentDetails" asp-controller="Student" asp-route-id="@item.Id" method="post">
                    <button type="submit" style="">Details</button>
                </form>|
                <!-- Replaces actionlink, passes the student's id as part of the URL for the post request-->                
                <form asp-action="Delete" asp-controller="Student" asp-route-id="@item.Id" method="post"
                    onsubmit="return confirm('Are you sure you want to delete @item.Name (ID: @item.Id)?');"
                    class="d-inline">
                    <button type="submit" style="">Delete</button>
                </form>
                  
            </td>
        </tr>        
    }
    </tbody>
</table>
